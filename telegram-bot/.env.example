# Скопируйте этот файл в .env и впишите свои значения.
# Токен выдаёт @BotFather, ID чата узнаёт @userinfobot (личный чат) или @getidsbot (группа).
BOT_TOKEN=123456789:replace-with-token-from-botfather
ADMIN_CHAT_ID=123456789

