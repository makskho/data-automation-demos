# Copy to .env and fill in. Empty value = that channel is switched off.

# --- Webhook ---
# Secret appended to the webhook URL as ?key=... (leave empty to disable the check)
WEBHOOK_SECRET=change-me-long-random-string
# Where the SQLite file (duplicates + outbox) lives. Put it on a persistent disk.
DB_PATH=leads.db
# Timezone for timestamps in messages and rows
TIMEZONE=Europe/Moscow
# Duplicate window, seconds (same tranid or same name/phone/email/text)
DEDUPE_WINDOW_SEC=600
# Hidden "trap" fields; a bot fills them, a human does not (comma separated)
HONEYPOT_FIELDS=website,hp,botcheck,_honeypot

# --- Retry of failed deliveries ---
MAX_ATTEMPTS=8
BACKOFF_BASE_SEC=30
BACKOFF_MAX_SEC=3600

# --- 1. Google Sheets ---
# Service-account JSON file; share the spreadsheet with its client_email (Editor)
SHEETS_CREDENTIALS_FILE=service-account.json
# The id from the spreadsheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit
SHEETS_SPREADSHEET_ID=
# Worksheet (tab) name; empty = the first tab
SHEETS_WORKSHEET=

# --- 2. Telegram ---
# Token from @BotFather; chat id of a person, group or channel where the bot is added
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 3. Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Several recipients: comma separated
SMTP_TO=
# STARTTLS on ports other than 465 (465 uses implicit SSL)
SMTP_STARTTLS=1
